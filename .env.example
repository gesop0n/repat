# development | production
REPAT_ENV=development
REPAT_SERVER_PORT=8080
# カンマ区切りの IP / CIDR。未設定なら X-Forwarded-For を信用しない
REPAT_TRUSTED_PROXIES=
# ローカル: `supabase status` の Database URL
# 本番: Supabase の Session pooler (ポート 5432)。Transaction pooler (6543) はプリペアドステートメントが使えない
# 接続数の上限は末尾に ?pool_max_conns=5 のように付けて指定する
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# アクセストークンの発行元 (iss) と JWKS の取得先。本番: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# ローカルの Supabase Auth で GitHub ログインを使うときに設定する (supabase/config.toml から参照される)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# フロントエンド (ビルド時に埋め込まれる)
# development | production
VITE_REPAT_ENV=development
VITE_SUPABASE_URL=http://127.0.0.1:54321
# ローカルの値は Supabase CLI 共通の既定値。本番はダッシュボードの Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
